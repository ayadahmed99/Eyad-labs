# AI_API_KEY: Optional API key for your custom or OpenAI-compatible AI provider.
# Users configure this via the Secrets panel in the AI Studio UI.
# In the app, if not configured, a smart built-in simulated AI assistant runs seamlessly.
AI_API_KEY=MY_AI_API_KEY
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

